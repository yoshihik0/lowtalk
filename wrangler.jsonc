{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lowtalk",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" }
  }
}
